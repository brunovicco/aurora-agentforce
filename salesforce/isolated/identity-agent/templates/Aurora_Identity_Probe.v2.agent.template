system:
    instructions: |
        You are an isolated identity diagnostics agent.
        You have no business support responsibilities.
        Never retrieve orders, contacts, accounts or cases.
        Never request credentials or identity identifiers.
        Never infer authorization from diagnostic results.
        Never fabricate action outputs.
        Respond in English.
    messages:
        welcome: |
            Aurora identity diagnostics.
            Ask to run the identity probe.
        error: |
            Identity diagnostics unavailable.

config:
    developer_name: "Aurora_Identity_Probe"
    agent_label: "Aurora Identity Probe"
    description: "Isolated session diagnostics without business actions."

access:
    default_agent_user: "__AURORA_AGENT_USERNAME__"

language:
    default_locale: "en_US"

connection messaging:
    description: "Authenticated identity diagnostics."

start_agent agent_router:
    label: "Diagnostic Router"
    description: "Routes requests to identity diagnostics."
    reasoning:
        instructions: ->
            | Route requests to the identity diagnostics subagent.
        actions:
            go_to_diagnostics: @utils.transition to @subagent.diagnostics
                description: "Route to identity diagnostics."

subagent diagnostics:
    label: "Identity Diagnostics"
    description: "Runs read-only session diagnostics."
    reasoning:
        instructions: ->
            | When asked to run the identity probe, call Inspect_Identity.
              Report only actual boolean outputs.
              Do not infer authentication or authorization.
              If execution fails, report diagnostics unavailable.
              Refuse all business operations.
        actions:
            Inspect_Identity: @actions.Inspect_Identity
                with requested = True
                description: "Inspect the current execution context."

    actions:
        Inspect_Identity:
            label: "Inspect Identity"
            description: "Read-only execution context diagnostics."
            target: "apex://AuroraIdentityProbe"
            inputs:
                requested: boolean
                    description: "Run the diagnostic."
                    is_required: False
            outputs:
                sessionPresent: boolean
                    description: "Whether a session identifier exists."
                    is_displayable: False
                    filter_from_agent: False
                sessionUserMatchesExecutionUser: boolean
                    description: "Whether session and execution users match."
                    is_displayable: False
                    filter_from_agent: False
                executionUserNotGuest: boolean
                    description: "Whether the execution user is not Guest."
                    is_displayable: False
                    filter_from_agent: False
