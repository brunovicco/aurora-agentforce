{
  "openapi": "3.0.3",
  "info": {
    "title": "Aurora Orders",
    "version": "0.1.0",
    "description": "Read-only operations for the Agentforce demo. The integration credential is scoped to one fictional customer."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/orders/{order_id}": {
      "get": {
        "operationId": "getOrder",
        "summary": "Retrieve an authorized fictional order.",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Fictional order ID, for example AUR-1001.",
            "schema": {
              "type": "string",
              "pattern": "^AUR-[0-9]{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "order_id",
                    "product",
                    "status"
                  ],
                  "properties": {
                    "order_id": {
                      "type": "string"
                    },
                    "product": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "processing",
                        "shipped",
                        "delivered",
                        "cancelled"
                      ]
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid integration credential.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found or unavailable to the demo customer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/return-eligibility": {
      "get": {
        "operationId": "checkReturnEligibility",
        "summary": "Evaluate the fictional return policy.",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "description": "Fictional order ID, for example AUR-1001.",
            "schema": {
              "type": "string",
              "pattern": "^AUR-[0-9]{4}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Request completed successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "order_id",
                    "eligible",
                    "reason_code",
                    "reason",
                    "policy_reference",
                    "evaluated_on"
                  ],
                  "properties": {
                    "order_id": {
                      "type": "string"
                    },
                    "eligible": {
                      "type": "boolean"
                    },
                    "reason_code": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "policy_reference": {
                      "type": "string"
                    },
                    "evaluated_on": {
                      "type": "string",
                      "format": "date"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid integration credential.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Order not found or unavailable to the demo customer.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "detail"
                  ],
                  "properties": {
                    "detail": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}
